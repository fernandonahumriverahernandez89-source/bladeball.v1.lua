-- ============================
-- 🔴 ESP (sin parpadeo, como ya teníamos)
-- ============================
local highlightESP = nil

local function crearHighlight()
    if highlightESP and highlightESP.Parent then return highlightESP end
    local hl = Instance.new("Highlight")
    hl.Name = "BolaESP_BladeBall"
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.OutlineColor = Color3.fromRGB(255, 50, 50)
    hl.FillTransparency = 0.4
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = screenGui
    highlightESP = hl
    return hl
end

local function aplicarESP(bola)
    if not bola then
        if highlightESP then highlightESP.Adornee = nil end
        return
    end
    local hl = crearHighlight()
    if hl.Adornee ~= bola then
        hl.Adornee = bola
    end
end

local function limpiarESP()
    if highlightESP then highlightESP.Adornee = nil end
end

-- ============================
-- 🔄 LOOP PRINCIPAL
-- ============================
task.spawn(function()
    local contador = 0
    while true do
        RunService.Heartbeat:Wait()
        contador = contador + 1
        if contador % 3 ~= 0 then continue end

        local bola, dist = obtenerBola()
        local jog, distJog = jugadorCercano()

        if contador % 10 == 0 then
            local remoteOk = buscarParryRemote() and "✅" or "❌"
            if bola then
                status.Text = string.format("Bola: %.0f | Jug: %.0f\nRemote: %s", dist or 0, distJog or 0, remoteOk)
            else
                status.Text = "Sin bola | Remote: " .. remoteOk
            end
        end

        if config.ballESP then
            aplicarESP(bola)
        elseif highlightESP and highlightESP.Adornee then
            limpiarESP()
        end

        if config.autoParry and bola and dist and dist <= config.studs then
            activarParry()
            task.wait(delayHumano(config.parryDelayMin, config.parryDelayMax))
        end

        if config.autoSpam and jog and distJog and distJog <= config.spamRange then
            activarParry()
            task.wait(delayHumano(config.spamDelayMin, config.spamDelayMax))
        end
    end
end)

