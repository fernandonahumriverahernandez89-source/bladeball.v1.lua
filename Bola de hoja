-- ============================
-- 🔴 ESP
-- ============================
local function aplicarESP(bola)
    if bola and not bola:FindFirstChildOfClass("Highlight") then
        local hl = Instance.new("Highlight")
        hl.FillColor = Color3.fromRGB(255, 0, 0)
        hl.OutlineColor = Color3.fromRGB(255, 0, 0)
        hl.FillTransparency = 0.3
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = bola
        hl.Parent = bola
    end
end

local function limpiarESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Highlight") then
            local ad = obj.Adornee
            if ad and esBolaReal(ad) then
                obj:Destroy()
            end
        end
    end
end

-- ============================
-- 🔄 LOOP PRINCIPAL
-- ============================
task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()

        local bola, dist = obtenerBola()
        local jog, distJog = jugadorCercano()

        if bola then
            status.Text = string.format("🎯 %.0f | 👤 %.0f", dist or 0, distJog or 0)
        else
            status.Text = "❌ Sin bola | 👤 " .. string.format("%.0f", distJog or 0)
        end

        if config.ballESP and bola then
            aplicarESP(bola)
        elseif not config.ballESP then
            limpiarESP()
        end

        if config.autoParry and bola and dist and dist <= config.studs then
            activarParry()
            task.wait(config.parryDelay)
        end

        if config.autoSpam and jog and distJog and distJog <= config.spamRange then
            activarParry()
            task.wait(config.spamDelay)
        end
    end
end)

