-- 🛡️ FUNCIONES DEL JUEGO
-- ============================
local function activarParry()
    local character = LocalPlayer.Character
    if not character then return end
    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
    end
end

local function obtenerBolaCercana()
    local character = LocalPlayer.Character
    if not character then return nil end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local ballsFolder = workspace:FindFirstChild("Balls")
    if not ballsFolder then return nil end

    local masCercana, distanciaMin = nil, math.huge
    for _, ball in ipairs(ballsFolder:GetChildren()) do
        if ball:IsA("BasePart") then
            local d = (ball.Position - root.Position).Magnitude
            if d < distanciaMin then
                distanciaMin = d
                masCercana = ball
            end
        end
    end
    return masCercana, distanciaMin
end

-- AUTO PARRY
task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        if config.autoParry then
            local _, dist = obtenerBolaCercana()
            if dist and dist <= config.studs then
                task.wait(config.parryDelay)
                activarParry()
            end
        end
    end
end)

-- AUTO SPAM
task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        if config.autoSpam then
            activarParry()
            task.wait(config.spamDelay)
        else
            task.wait(0.1)
        end
    end
end)

-- BALL ESP (rojo)
local espConexion
local ballHighlights = {}

local function limpiarESP()
    for _, hl in ipairs(ballHighlights) do
        if hl and hl.Parent then hl:Destroy() end
    end
    ballHighlights = {}
end

local function iniciarESP()
    -- Limpiar primero
    limpiarESP()

    -- Crear highlights para las bolas existentes
    local ballsFolder = workspace:FindFirstChild("Balls")
    if ballsFolder then
        for _, ball in ipairs(ballsFolder:GetChildren()) do
            if ball:IsA("BasePart") then
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255, 0, 0)
                hl.OutlineColor = Color3.fromRGB(255, 80, 80)
                hl.FillTransparency = 0.4
                hl.OutlineTransparency = 0
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Adornee = ball
                hl.Parent = ball
                table.insert(ballHighlights, hl)
            end
        end
    end
end

-- Loop para aplicar ESP a nuevas bolas
task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        if config.ballESP then
            local ballsFolder = workspace:FindFirstChild("Balls")
            if ballsFolder then
                for _, ball in ipairs(ballsFolder:GetChildren()) do
                    if ball:IsA("BasePart") and not ball:FindFirstChildOfClass("Highlight") then
                        local hl = Instance.new("Highlight")
                        hl.FillColor = Color3.fromRGB(255, 0, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 80, 80)
                        hl.FillTransparency = 0.4
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = ball
                        hl.Parent = ball
                        table.insert(ballHighlights, hl)
                    end
                end
            end
        end
    end
end)

