-- ============================
-- 📡 REMOTES
-- ============================
local remoteParryAttempt = nil
local remoteParryAttemptAll = nil

local function buscarRemotes()
    if not remoteParryAttempt or not remoteParryAttempt.Parent then
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                if obj.Name == "ParryAttempt" then remoteParryAttempt = obj end
                if obj.Name == "ParryAttemptAll" then remoteParryAttemptAll = obj end
            end
        end
    end
end

-- ============================
-- 🛡️ 6 MÉTODOS DE PARRY
-- ============================
local function parry1_remoteSimple()
    -- Método 1: ParryAttempt:FireServer() sin args
    buscarRemotes()
    if remoteParryAttempt then
        pcall(function() remoteParryAttempt:FireServer() end)
        return true
    end
    return false
end

local function parry2_remoteBall()
    -- Método 2: ParryAttempt:FireServer(ball) con la bola
    buscarRemotes()
    if remoteParryAttempt then
        local bola = nil
        local folder = workspace:FindFirstChild("Balls")
        if folder then
            for _, obj in ipairs(folder:GetChildren()) do
                if obj:GetAttribute("realBall") then bola = obj break end
            end
        end
        pcall(function() remoteParryAttempt:FireServer(bola) end)
        return true
    end
    return false
end

local function parry3_remoteAll()
    -- Método 3: ParryAttemptAll:FireServer()
    buscarRemotes()
    if remoteParryAttemptAll then
        pcall(function() remoteParryAttemptAll:FireServer() end)
        return true
    end
    return false
end

local function parry4_tool()
    -- Método 4: Tool:Activate()
    local char = LocalPlayer.Character
    if not char then return false end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
        return true
    end
    return false
end

local function parry5_vimClick()
    -- Método 5: VirtualInputManager click
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
    return true
end

local function parry6_remoteYTool()
    -- Método 6: Combinado (remote + tool)
    buscarRemotes()
    local ok = false
    if remoteParryAttempt then
        pcall(function() remoteParryAttempt:FireServer() end)
        ok = true
    end
    local char = LocalPlayer.Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            pcall(function() tool:Activate() end)
            ok = true
        end
    end
    return ok
end

