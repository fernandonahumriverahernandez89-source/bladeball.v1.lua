-- DIAGNOSTICO VISUAL - Muestra los resultados en pantalla
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- Crear ventana
local sg = Instance.new("ScreenGui")
sg.Name = "DiagnosticoBB"
sg.ResetOnSpawn = false
sg.IgnoreGuiInset = true
sg.Parent = LocalPlayer:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 320, 0, 400)
frame.Position = UDim2.new(0, 10, 0.1, 0)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
frame.BorderSizePixel = 0
frame.Parent = sg
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

local stroke = Instance.new("UIStroke", frame)
stroke.Color = Color3.fromRGB(120, 80, 255)
stroke.Thickness = 1.5

local titulo = Instance.new("TextLabel")
titulo.Size = UDim2.new(1, 0, 0, 30)
titulo.BackgroundColor3 = Color3.fromRGB(30, 25, 50)
titulo.BorderSizePixel = 0
titulo.Text = "🔍 DIAGNOSTICO BLADE BALL"
titulo.TextColor3 = Color3.fromRGB(180, 140, 255)
titulo.TextScaled = true
titulo.Font = Enum.Font.GothamBold
titulo.Parent = frame
Instance.new("UICorner", titulo).CornerRadius = UDim.new(0, 8)

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1, -20, 1, -60)
scroll.Position = UDim2.new(0, 10, 0, 40)
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 4
scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.Parent = frame

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 4)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = scroll

-- Función para agregar línea
local contador = 0
local function addLinea(texto, color)
    contador = contador + 1
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 0)
    label.AutomaticSize = Enum.AutomaticSize.Y
    label.BackgroundTransparency = 1
    label.Text = texto
    label.TextColor3 = color or Color3.fromRGB(220, 220, 240)
    label.TextScaled = false
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextWrapped = true
    label.Font = Enum.Font.Code
    label.LayoutOrder = contador
    label.Parent = scroll
    return label
end

local verde = Color3.fromRGB(100, 255, 100)
local rojo = Color3.fromRGB(255, 100, 100)
local amarillo = Color3.fromRGB(255, 220, 100)
local azul = Color3.fromRGB(120, 180, 255)

addLinea("=== DIAGNOSTICO ===", amarillo)

-- 1. Balls folder
local balls = workspace:FindFirstChild("Balls")
if balls then
    addLinea("✅ workspace.Balls:", verde)
    for _, obj in ipairs(balls:GetChildren()) do
        addLinea("  • " .. obj.Name .. " [" .. obj.ClassName .. "]", azul)
    end
else
    addLinea("❌ No hay workspace.Balls", rojo)
end

-- 2. Objetos con "ball"
addLinea("", amarillo)
addLinea("🎯 Objetos 'ball':", amarillo)
local encontrados = 0
for _, obj in ipairs(workspace:GetDescendants()) do
    local n = string.lower(obj.Name)
    if n:find("ball") and obj:IsA("BasePart") then
        encontrados = encontrados + 1
        if encontrados <= 15 then
            addLinea("  • " .. obj.Name .. " (Parent: " .. (obj.Parent and obj.Parent.Name or "?") .. ")", azul)
        end
    end
end
if encontrados == 0 then
    addLinea("  ❌ Ninguno", rojo)
else
    addLinea("  Total: " .. encontrados, verde)
end

-- 3. Remotes
addLinea("", amarillo)
addLinea("📡 Remotes importantes:", amarillo)
local remotesEncontrados = 0
for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
        local n = string.lower(obj.Name)
        if n:find("parry") or n:find("swing") or n:find("hit") or n:find("attack") or n:find("clash") or n:find("block") or n:find("ball") or n:find("slash") then
            remotesEncontrados = remotesEncontrados + 1
            addLinea("  • " .. obj.Name .. " [" .. obj.ClassName .. "]", verde)
        end
    end
end
if remotesEncontrados == 0 then
    addLinea("  ❌ Ninguno con nombre conocido", rojo)
end

-- 4. Ver TODOS los remotes (por si acaso)
addLinea("", amarillo)
addLinea("📡 TODOS los remotes (primeros 20):", amarillo)
local todos = 0
for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
        todos = todos + 1
        if todos <= 20 then
            addLinea("  • " .. obj.Name, Color3.fromRGB(180, 180, 200))
        end
    end
end
addLinea("  Total remotes: " .. todos, verde)

-- 5. Herramientas
addLinea("", amarillo)
addLinea("🗡️ Tus herramientas:", amarillo)
local char = LocalPlayer.Character
if char then
    local tieneTool = false
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Tool") then
            addLinea("  • " .. obj.Name, verde)
            tieneTool = true
        end
    end
    if not tieneTool then
        addLinea("  ❌ Ninguna equipada", rojo)
    end
else
    addLinea("  ❌ Sin personaje", rojo)
end

-- 6. Backpack
addLinea("", amarillo)
addLinea("🎒 Tu backpack:", amarillo)
local backpack = LocalPlayer:FindFirstChild("Backpack")
if backpack then
    for _, obj in ipairs(backpack:GetChildren()) do
        if obj:IsA("Tool") then
            addLinea("  • " .. obj.Name, Color3.fromRGB(180, 220, 255))
        end
    end
end

addLinea("", amarillo)
addLinea("=== FIN ===", amarillo)
addLinea("Saca captura de esto 📸", verde)

