-- ============================
-- 🔴 ESP (Highlight en la bola)
-- ============================
local function aplicarESP()
    local bola = obtenerBola()
    if bola and not bola:FindFirstChildOfClass("Highlight") then
        local hl = Instance.new("Highlight")
        hl.FillColor = Color3.fromRGB(255, 0, 0)
        hl.OutlineColor = Color3.fromRGB(255, 80, 80)
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = bola
        hl.Parent = bola
    end
end

-- ============================
-- 🔄 LOOP PRINCIPAL
-- ============================
task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()

        local bola, dist = obtenerBola()

        -- Status en la UI
        if bola then
            status.Text = string.format("🎯 Bola: %s\n📏 Dist: %.1f | Studs: %d", bola.Name, dist or 0, config.studs)
        else
            status.Text = "❌ No se encontró la bola"
        end

        -- ESP
        if config.ballESP and bola then
            aplicarESP()
        end

        -- Auto Parry
        if config.autoParry and bola and dist and dist <= config.studs then
            task.wait(config.parryDelay)
            activarParry()
        end

        -- Auto Spam
        if config.autoSpam then
            activarParry()
            task.wait(config.spamDelay)
        end
    end
end)
