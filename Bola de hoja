-- ============================
-- 🎯 DETECCIÓN DE BOLA (ignora BallSpawn)
-- ============================
local function esBolaReal(obj)
    if not obj:IsA("BasePart") then return false end
    local n = string.lower(obj.Name)
    if n:find("spawn") then return false end
    if n:find("decal") then return false end
    if n:find("marker") then return false end
    return n == "ball" or n == "bola" or n:find("^ball") or n:find("^bola")
end

local function obtenerBola()
    local character = LocalPlayer.Character
    if not character then return nil, nil end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil, nil end

    local masCercana, distMin = nil, math.huge
    local ballsFolder = workspace:FindFirstChild("Balls")
    if ballsFolder then
        for _, obj in ipairs(ballsFolder:GetChildren()) do
            if esBolaReal(obj) then
                local d = (obj.Position - root.Position).Magnitude
                if d < distMin then
                    distMin = d
                    masCercana = obj
                end
            end
        end
    end

    if not masCercana then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if esBolaReal(obj) then
                local d = (obj.Position - root.Position).Magnitude
                if d < distMin then
                    distMin = d
                    masCercana = obj
                end
            end
        end
    end

    return masCercana, distMin
end

-- ============================
-- 👤 JUGADOR MÁS CERCANO (para spam)
-- ============================
local function jugadorCercano()
    local character = LocalPlayer.Character
    if not character then return nil, nil end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil, nil end

    local masCercano, distMin = nil, math.huge
    for _, jugador in ipairs(Players:GetPlayers()) do
        if jugador ~= LocalPlayer and jugador.Character then
            local hrp = jugador.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - root.Position).Magnitude
                if d < distMin then
                    distMin = d
                    masCercano = jugador
                end
            end
        end
    end
    return masCercano, distMin
end

-- ============================
-- 📱 PARRY POR TOQUE (funciona en celular)
-- ============================
local function tocarPantalla()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

local function activarParry()
    tocarPantalla()

    local character = LocalPlayer.Character
    if character then
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            pcall(function() tool:Activate() end)
        end
    end
end

