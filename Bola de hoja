-- ============================
-- 🎯 INFO BOLA
-- ============================
local function obtenerInfoBola()
    local char = LocalPlayer.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local folder = workspace:FindFirstChild("Balls")
    if not folder then return nil end

    local bolaCercana, distMin = nil, math.huge
    for _, obj in ipairs(folder:GetChildren()) do
        if obj:IsA("BasePart") and obj:GetAttribute("realBall") then
            local d = (obj.Position - root.Position).Magnitude
            if d < distMin then distMin = d; bolaCercana = obj end
        end
    end
    if not bolaCercana then return nil end

    local vel = bolaCercana.AssemblyLinearVelocity
    local velMag = vel.Magnitude
    local haciaMi = (root.Position - bolaCercana.Position)
    local viene = velMag > 0.1 and vel.Unit:Dot(haciaMi.Unit) > 0.3

    -- Predicción
    local distMinProyectada = math.huge
    local tiempoMinProyectada = 0
    for t = 0, 2, 0.05 do
        local posFutura = bolaCercana.Position + vel * t
        local d = (posFutura - root.Position).Magnitude
        if d < distMinProyectada then
            distMinProyectada = d
            tiempoMinProyectada = t
        end
    end
    local meVaAPegar = distMinProyectada < 4

    return {
        bola = bolaCercana,
        distancia = distMin,
        velocidad = velMag,
        vieneHaciaMi = viene,
        tiempoLlegada = velMag > 0.1 and (distMin / velMag) or 0,
        tiempoMinProyectada = tiempoMinProyectada,
        meVaAPegar = meVaAPegar,
    }
end

-- ============================
-- 🛡️ DISPARAR PARRY
-- ============================
local ultimoParry = 0
local function dispararParry()
    if tick() - ultimoParry < config.cooldown then return false end
    ultimoParry = tick()
    local fn = metodos[config.metodo]
    if fn and fn() then
        stats.parrys = stats.parrys + 1
        return true
    end
    return false
end

