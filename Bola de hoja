local function crearToggle(nombre, posY, callback)
    local boton = Instance.new("TextButton")
    boton.Size = UDim2.new(0.9, 0, 0, 35)
    boton.Position = UDim2.new(0.05, 0, 0, posY)
    boton.BackgroundColor3 = Color3.fromRGB(35, 30, 50)
    boton.Text = ""
    boton.BorderSizePixel = 0
    boton.AutoButtonColor = false
    boton.Parent = main

    local cornerB = Instance.new("UICorner")
    cornerB.CornerRadius = UDim.new(0, 6)
    cornerB.Parent = boton

    local texto = Instance.new("TextLabel")
    texto.Size = UDim2.new(1, -50, 1, 0)
    texto.Position = UDim2.new(0, 12, 0, 0)
    texto.BackgroundTransparency = 1
    texto.Text = nombre
    texto.TextColor3 = Color3.fromRGB(220, 220, 240)
    texto.TextXAlignment = Enum.TextXAlignment.Left
    texto.TextScaled = true
    texto.Font = Enum.Font.Gotham
    texto.Parent = boton

    -- Indicador ON/OFF
    local estado = Instance.new("Frame")
    estado.Size = UDim2.new(0, 40, 0, 20)
    estado.Position = UDim2.new(1, -50, 0.5, -10)
    estado.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    estado.BorderSizePixel = 0
    estado.Parent = boton

    local cornerE = Instance.new("UICorner")
    cornerE.CornerRadius = UDim.new(1, 0)
    cornerE.Parent = estado

    local bolita = Instance.new("Frame")
    bolita.Size = UDim2.new(0, 16, 0, 16)
    bolita.Position = UDim2.new(0, 2, 0.5, -8)
    bolita.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    bolita.BorderSizePixel = 0
    bolita.Parent = estado

    local cornerBol = Instance.new("UICorner")
    cornerBol.CornerRadius = UDim.new(1, 0)
    cornerBol.Parent = bolita

    local activo = false
    boton.MouseButton1Click:Connect(function()
        activo = not activo
        if activo then
            TweenService:Create(estado, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(120, 80, 255)
            }):Play()
            TweenService:Create(bolita, TweenInfo.new(0.2), {
                Position = UDim2.new(1, -18, 0.5, -8),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            }):Play()
        else
            TweenService:Create(estado, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(60, 60, 70)
            }):Play()
            TweenService:Create(bolita, TweenInfo.new(0.2), {
                Position = UDim2.new(0, 2, 0.5, -8),
                BackgroundColor3 = Color3.fromRGB(200, 200, 200)
            }):Play()
        end
        callback(activo)
    end)

    return boton
end

