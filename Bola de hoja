-- 🔄 LOOP
-- ============================
task.spawn(function()
    local c = 0
    while true do
        RunService.Heartbeat:Wait()
        c = c + 1

        local info = obtenerInfoBola()
        local cerca = info and info.distancia < 100

        if not cerca and c % 3 ~= 0 then continue end

        if info then
            if config.ballESP then
                local bb = crearESP()
                if bb.Adornee ~= info.bola then bb.Adornee = info.bola end
            elseif bbESP then
                bbESP.Adornee = nil
            end

            if c % 6 == 0 then
                lEstado.Text = "✅ Bola detectada"
                lEstado.TextColor3 = Color3.fromRGB(100, 255, 100)
                lDist.Text = string.format("📏 Dist: %.0f", info.distancia)
                lVel.Text = string.format("⚡ Vel: %.0f", info.velocidad)
                if info.vieneHaciaMi then
                    lDir.Text = "🎯 VINIENDO"
                    lDir.TextColor3 = Color3.fromRGB(255, 80, 80)
                    lTiempo.Text = string.format("⏱️ Llegada: %.2fs", info.tiempoLlegada)
                else
                    lDir.Text = "🎯 Alejándose"
                    lDir.TextColor3 = Color3.fromRGB(100, 200, 255)
                    lTiempo.Text = "⏱️ Llegada: --"
                end
                if info.meVaAPegar then
                    lVaPegar.Text = "⚠️ ¿Te pega?: SÍ"
                    lVaPegar.TextColor3 = Color3.fromRGB(255, 80, 80)
                else
                    lVaPegar.Text = "⚠️ ¿Te pega?: NO"
                    lVaPegar.TextColor3 = Color3.fromRGB(100, 255, 100)
                end
                lParrys.Text = "✅ Parrys: " .. stats.parrys
            end

            local llenado = 0
            if info.vieneHaciaMi and info.tiempoMinProyectada > 0 then
                llenado = math.clamp(1 - (info.tiempoMinProyectada / config.tiempoParry), 0, 1)
            end
            barraFill.Size = UDim2.new(llenado, 0, 1, 0)
            if llenado > 0.8 then
                barraFill.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
            elseif llenado > 0.5 then
                barraFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
            else
                barraFill.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
            end

            if config.autoParry then
                local puede = info.vieneHaciaMi
                    and info.tiempoMinProyectada > 0
                    and info.tiempoMinProyectada <= config.tiempoParry
                if soloSiVa then puede = puede and info.meVaAPegar end
                if puede then dispararParry() end
            end
        else
            if c % 15 == 0 then
                lEstado.Text = "❌ No hay bola"
                lEstado.TextColor3 = Color3.fromRGB(255, 100, 100)
                lDist.Text = "📏 Dist: --"
                lVel.Text = "⚡ Vel: --"
                lDir.Text = "🎯 Dir: --"
                lTiempo.Text = "⏱️ Llegada: --"
                lVaPegar.Text = "⚠️ ¿Te pega?: --"
                barraFill.Size = UDim2.new(0, 0, 1, 0)
            end
            if bbESP then bbESP.A
