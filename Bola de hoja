-- ============================
-- 📡 BUSCAR REMOTE CORRECTO (ParryButtonPress)
-- ============================
local parryRemote = nil

local function buscarParryRemote()
    if parryRemote and parryRemote.Parent then return parryRemote end
    
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        parryRemote = remotes:FindFirstChild("ParryButtonPress")
    end
    return parryRemote
end

-- ============================
-- 🎯 DETECCIÓN DE BOLA REAL (usando el atributo realBall)
-- ============================
local ballsFolder = nil
local function obtenerBallsFolder()
    if ballsFolder and ballsFolder.Parent then return ballsFolder end
    ballsFolder = workspace:FindFirstChild("Balls")
    return ballsFolder
end

local function esBolaReal(obj)
    if not obj:IsA("BasePart") then return false end
    -- La bola real tiene el atributo "realBall" en true
    return obj:GetAttribute("realBall") == true
end

local function obtenerBola()
    local character = LocalPlayer.Character
    if not character then return nil, nil end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil, nil end

    local folder = obtenerBallsFolder()
    if not folder then return nil, nil end

    local masCercana, distMin = nil, math.huge
    for _, obj in ipairs(folder:GetChildren()) do
        if esBolaReal(obj) then
            local d = (obj.Position - root.Position).Magnitude
            if d < distMin then
                distMin = d
                masCercana = obj
            end
        end
    end
    return masCercana, distMin
end

-- ============================
-- 👤 JUGADOR CERCANO
-- ============================
local function jugadorCercano()
    local character = LocalPlayer.Character
    if not character then return nil, nil end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil, nil end

    local masCercano, distMin = nil, math.huge
    for _, jugador in ipairs(Players:GetPlayers()) do
        if jugador ~= LocalPlayer and jugador.Character then
            local hrp = jugador.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - root.Position).Magnitude
                if d < distMin then
                    distMin = d
                    masCercano = jugador
                end
            end
        end
    end
    return masCercano, distMin
end

-- ============================
-- 🛡️ PARRY (con el remote correcto)
-- ============================
local function activarParry()
    local remote = buscarParryRemote()
    if not remote then return false end
    pcall(function() remote:Fire() end) -- Se usa :Fire()
    return true
end

local function delayHumano(min, max)
    return min + math.random() * (max - min)
end

