-- ============================
-- 🎯 BUSCAR BOLA (más flexible)
-- ============================
local function obtenerBola()
    local character = LocalPlayer.Character
    if not character then return nil, nil end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil, nil end

    local masCercana, distanciaMin = nil, math.huge

    -- Buscar en TODO el workspace
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = string.lower(obj.Name)
            local esBola = n:find("ball") or n:find("bola") or n == "sphere"
            if esBola then
                local d = (obj.Position - root.Position).Magnitude
                if d < distanciaMin then
                    distanciaMin = d
                    masCercana = obj
                end
            end
        end
    end
    return masCercana, distanciaMin
end

-- ============================
-- 🛡️ PARRY (con múltiples métodos)
-- ============================
local function activarParry()
    local character = LocalPlayer.Character
    if not character then return false end

    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
        return true
    end

    -- Alternativa: buscar en backpack
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, t in ipairs(backpack:GetChildren()) do
            if t:IsA("Tool") then
                pcall(function() t:Activate() end)
                return true
            end
        end
    end
    return false
end

